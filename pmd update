cfg.put('EmptyStatementBlock', new List<String>{'3','Empty statement block: Remove or add intended implementation to avoid dead code.'});

List<copadoQuality__SCA_Rule__c> toUp = new List<copadoQuality__SCA_Rule__c>();
for (String n : cfg.keySet()) {
    if (rm.containsKey(n)) {
        copadoQuality__SCA_Rule__c r = rm.get(n);
        r.copadoQuality__Priority__c = cfg.get(n)[0];
        r.copadoQuality__Message__c = cfg.get(n)[1];
        toUp.add(r);
    } else {
        System.debug(LoggingLevel.WARN, 'NOT FOUND: ' + n);
    }
}

if (!toUp.isEmpty()) {
    update toUp;
    System.debug('Part 1 SUCCESS: Updated ' + toUp.size() + ' rules (Security + Performance + Error Prone)');
}


